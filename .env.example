# Cross-device sync (optional).
#
# Copy to `.env.local` and fill in from your Supabase project's
# Settings -> API page. `.env.local` is already gitignored via `*.local`.
#
# Leave these unset and the app runs exactly as it always has: fully local,
# no account, no network calls. Sync simply stays switched off.
#
# The anon key is a public client key and is meant to ship in the bundle —
# row-level security is what keeps your rows private, not this value.
# Never put the `service_role` key here; it bypasses RLS.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
